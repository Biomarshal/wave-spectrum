rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Songs collection
    match /songs/{songId} {
      allow read: if true;
      // Only admins can create, update, or delete songs
      allow create, update, delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      // Admins can read all, users can read their own profile
      allow read: if isAdmin() || isOwner(userId);

      // Create: user can create their own doc as 'listener', or admin can create anything
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == 'listener') || 
        isAdmin()
      );
      
      // Update: user can update their own doc but cannot change their role, or admin can update anything
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role) || 
        isAdmin()
      );

      // Only admins can delete users
      allow delete: if isAdmin();

      // User history sub-collection
      match /history/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId); // Only the user can record their own history
        allow delete: if isAdmin();
      }

      // User dailyStats sub-collection
      match /dailyStats/{dateId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isAdmin();
      }
    }
  }
}
